{
  "uid": "lamp-api",
  "title": "Lamp API (FastAPI OpenTelemetry)",
  "tags": [
    "lamp",
    "fastapi",
    "opentelemetry"
  ],
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "1m",
  "description": "HTTP server metrics FastAPI emits natively over OpenTelemetry, as stored in the Azure Monitor workspace (delta histograms: queried with sum_over_time).",
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests / s",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(histogram_count(sum_over_time({\"http.server.request.duration\",\"service.name\"=\"lamp-app\"}[$__range]))) / $__range_s",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Success rate (excl. event stream)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - (sum(histogram_count(sum_over_time({\"http.server.request.duration\",\"service.name\"=\"lamp-app\",\"http.route\"!=\"/api/v1/lamp/events\",\"http.response.status_code\"=~\"5..\"}[$__range]))) or vector(0)) / sum(histogram_count(sum_over_time({\"http.server.request.duration\",\"service.name\"=\"lamp-app\",\"http.route\"!=\"/api/v1/lamp/events\",\"http.route\"!=\"/api/v1/lamp/events\"}[$__range]))))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        },
        "overrides": []
      },
      "min": 0,
      "max": 100,
      "options": {
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p95 latency (excl. event stream)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(sum_over_time({\"http.server.request.duration\",\"service.name\"=\"lamp-app\",\"http.route\"!=\"/api/v1/lamp/events\"}[$__range])))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Requests in flight (last report)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum({\"http.server.active_requests\",\"service.name\"=\"lamp-app\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Replicas reporting",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (\"k8s.pod.name\") (last_over_time({\"http.server.active_requests\",\"service.name\"=\"lamp-app\"}[10m])))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Requests (range)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(histogram_count(sum_over_time({\"http.server.request.duration\",\"service.name\"=\"lamp-app\"}[$__range])))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Request rate by route",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (\"http.route\")(histogram_count(sum_over_time({\"http.server.request.duration\",\"service.name\"=\"lamp-app\"}[$__interval]))) / ($__interval_ms / 1000)",
          "legendFormat": "{{http.route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Request rate by status code",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (\"http.response.status_code\")(histogram_count(sum_over_time({\"http.server.request.duration\",\"service.name\"=\"lamp-app\"}[$__interval]))) / ($__interval_ms / 1000)",
          "legendFormat": "{{http.response.status_code}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Latency percentiles (excl. event stream)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum(sum_over_time({\"http.server.request.duration\",\"service.name\"=\"lamp-app\",\"http.route\"!=\"/api/v1/lamp/events\"}[$__interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "interval": "1m"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(sum_over_time({\"http.server.request.duration\",\"service.name\"=\"lamp-app\",\"http.route\"!=\"/api/v1/lamp/events\"}[$__interval])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "interval": "1m"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(sum_over_time({\"http.server.request.duration\",\"service.name\"=\"lamp-app\",\"http.route\"!=\"/api/v1/lamp/events\"}[$__interval])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "p95 latency by route (excl. event stream)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (\"http.route\")(sum_over_time({\"http.server.request.duration\",\"service.name\"=\"lamp-app\",\"http.route\"!=\"/api/v1/lamp/events\"}[$__interval])))",
          "legendFormat": "{{http.route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Errors by route (excl. event stream, which ends in ConnectionError when a page closes)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (\"http.route\") (histogram_count(sum_over_time({\"http.server.request.duration\",\"service.name\"=\"lamp-app\",\"http.response.status_code\"=~\"5..\"}[$__interval]))) / ($__interval_ms / 1000)",
          "legendFormat": "5xx {{http.route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "interval": "1m"
        },
        {
          "refId": "B",
          "expr": "sum by (\"http.route\", \"error.type\") (histogram_count(sum_over_time({\"http.server.request.duration\",\"service.name\"=\"lamp-app\",\"http.route\"!=\"/api/v1/lamp/events\",\"error.type\"!=\"\"}[$__interval]))) / ($__interval_ms / 1000)",
          "legendFormat": "{{error.type}} {{http.route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Requests in flight by replica (last report)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (\"k8s.pod.name\") ({\"http.server.active_requests\",\"service.name\"=\"lamp-app\"})",
          "legendFormat": "{{k8s.pod.name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "table",
      "title": "Routes",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (\"http.route\") (histogram_count(sum_over_time({\"http.server.request.duration\",\"service.name\"=\"lamp-app\"}[$__range])))",
          "legendFormat": "requests",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "interval": "1m",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (\"http.route\") (sum_over_time({\"http.server.request.duration\",\"service.name\"=\"lamp-app\"}[$__range])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "interval": "1m",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "http.route",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true
            },
            "renameByName": {
              "Value #A": "Requests",
              "Value #B": "p95 (s)",
              "http.route": "Route"
            }
          }
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Event streams closed / s",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(histogram_count(sum_over_time({\"http.server.request.duration\",\"service.name\"=\"lamp-app\",\"http.route\"=\"/api/v1/lamp/events\"}[$__interval]))) / ($__interval_ms / 1000)",
          "legendFormat": "streams",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "description": "A stream is counted when the page closes it: the request ends then."
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "How long pages keep the event stream open",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum(sum_over_time({\"http.server.request.duration\",\"service.name\"=\"lamp-app\",\"http.route\"=\"/api/v1/lamp/events\"}[$__interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "interval": "1m"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(sum_over_time({\"http.server.request.duration\",\"service.name\"=\"lamp-app\",\"http.route\"=\"/api/v1/lamp/events\"}[$__interval])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "description": "Not latency: the time between a page opening the live stream and closing it."
    }
  ]
}