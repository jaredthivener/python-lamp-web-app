{
  "uid": "k8s-cilium",
  "title": "Kubernetes / Cilium (CNI agent)",
  "tags": [
    "kubernetes",
    "cilium",
    "cni"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "1m",
  "description": "The Cilium agent on each node (Azure CNI Powered by Cilium): what the data plane forwards and drops, the health of its endpoints and controllers, and eBPF map headroom. These are the agent's own metrics, which AKS serves without Advanced Container Networking Services. Per-pod flows, DNS and drop attribution (Hubble) need that paid add-on and are not here.",
  "links": [
    {
      "type": "link",
      "title": "Cluster health",
      "url": "/d/k8s-cluster-health",
      "icon": "external link",
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "Network",
      "url": "/d/k8s-network",
      "icon": "external link",
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "DNS",
      "url": "/d/k8s-dns",
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Agents reporting",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(cilium_endpoint)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "One per node."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Endpoints ready / total",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(cilium_endpoint_state{endpoint_state=\"ready\"}) / sum(cilium_endpoint_state)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Endpoints are the pods (and a few reserved ones) Cilium manages. Below 100% means some are regenerating or waiting for an identity."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Dropped packets / s",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cilium_drop_count_total[$__rate_interval]))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Packets the data plane dropped, for any reason (policy denials show here). The panel below breaks it down."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Unreachable nodes",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(cilium_unreachable_nodes)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Failing controllers",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(cilium_controllers_failing)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "BPF map pressure (max)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(cilium_bpf_map_pressure)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "cilium_bpf_map_pressure is the ratio of the required map size to its configured size: below 1.0 is the utilisation, 1.0 or more means the map is full (Cilium metrics reference). Policy maps report only above 10% full."
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Forwarded packets by direction",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (direction)(rate(cilium_forward_count_total[$__rate_interval]))",
          "legendFormat": "{{direction}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Forwarded bytes by direction",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (direction)(rate(cilium_forward_bytes_total[$__rate_interval]))",
          "legendFormat": "{{direction}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Drops by reason",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason, direction)(rate(cilium_drop_count_total[$__rate_interval]))",
          "legendFormat": "{{reason}} ({{direction}})",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      },
      "description": "Why the data plane dropped packets (the reason strings are Cilium's, pkg/monitor/api/drop.go). 'Policy denied' means a policy dropped the packet. 'Unsupported L3 protocol' is the datapath's default case for a packet that is not a protocol it handles; on this cluster a few per minute appear from the start, and their source was not identified."
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Drops by node",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance)(rate(cilium_drop_count_total[$__rate_interval]))",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Endpoints by state",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (endpoint_state)(cilium_endpoint_state)",
          "legendFormat": "{{endpoint_state}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Endpoints and policies per node",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cilium_endpoint",
          "legendFormat": "endpoints {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "interval": "1m"
        },
        {
          "refId": "B",
          "expr": "cilium_policy",
          "legendFormat": "policies {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "BPF map pressure by map",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (map_name)(cilium_bpf_map_pressure)",
          "legendFormat": "{{map_name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Agent errors and warnings",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (level, subsystem)(increase(cilium_errors_warnings_total[$__rate_interval]))",
          "legendFormat": "{{level}} {{subsystem}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "Log lines at WARN and ERROR the agent counted, by subsystem. A steady stream from one subsystem is where to read the agent's logs."
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Identities",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (type)(cilium_identity)",
          "legendFormat": "{{type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "Security identities by type. Azure CNI Powered by Cilium documents a limit of 65,535 identities (https://learn.microsoft.com/azure/aks/azure-cni-powered-by-cilium#limitations)."
    }
  ]
}
