{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest *)",
      "Bash(uv run black *)",
      "Bash(uv run mypy *)",
      "Bash(npm test *)",
      "Bash(az bicep build *)",
      "Bash(az bicep lint *)",
      "Bash(flux schema validate *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "WebFetch(domain:learn.microsoft.com)",
      "WebFetch(domain:fluxcd.io)",
      "WebFetch(domain:code.claude.com)"
    ],
    "ask": [
      "Bash(az group delete *)",
      "Bash(az resource delete *)",
      "Bash(az deployment sub create *)",
      "Bash(azd provision *)",
      "Bash(azd down *)"
    ],
    "deny": [
      "Bash(gh pr merge *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/scratch-env.sh",
            "args": []
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/no-temp-dirs.sh",
            "args": []
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-edit.sh",
            "args": [],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
